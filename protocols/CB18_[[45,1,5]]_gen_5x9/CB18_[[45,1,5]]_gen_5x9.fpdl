    gvar:
        cnt n_c_same = 0;
        cnt n_same = 0;
        cnt n_diff = 0;
        cnt n_flag = 0;

        bit[44] s_prev = ⊥;
        bit diff_prev = 0;
        mr m = mr[];

    tc:
        1: ((n_c_same == 3 - n_diff - 1 and n_c_same != 0) and n_flag == 0)
        2: (n_diff == 2 and n_flag == 0)
        3: (n_flag == 2)
        4: (n_diff == 1 and n_flag == 1)
        5: (n_same == 1 and n_diff == 0 and n_flag == 1)

    af:
        while(!tc) {
            bit[44] s = ⊥;
            bit[32] f = ⊥;
            (s, f) = FSE_f();

            if (f != 0) {
                n_c_same = 0;
                n_same = 0;
                n_flag += 1;
                s_prev = ⊥;
                diff_prev = 0;
                m.push(f);
                continue;
            }

            if (s_prev != ⊥) {
                if (diff_prev == 1) { diff_prev = 0; }
                else if (s == s_prev) {
                    n_c_same += 1;
                    n_same += 1;
                }
                else {
                    n_c_same = 0;
                    n_diff += 1;
                    diff_prev = 1;
                }
            }
            s_prev = s;
        }

    tp:
        1: { decode(mr[s_prev]); }
        2: {
            bit[44] s = ⊥;
            (s,) = FSE_b();
            decode(mr[s]);
        }
        3: {
            bit[44] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m);
        }
        4: {
            bit[44] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m);
        }
        5: {
            m.push(s_prev);
            decode(m);
        }
