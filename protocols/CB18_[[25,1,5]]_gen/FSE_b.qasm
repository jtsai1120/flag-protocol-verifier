OPENQASM 3.0;
include "stdgates.inc";

// Serial unflagged extraction for the [[25,1,5]] rotated surface code,
// generated by gen_cb18_surface.py (CB18 Sec. 3, Fig. 2(b) flag circuit).
//   syndrome ancilla: |+> preparation, X-basis measurement
//   Z check: CZ(syn, data); X check: CX(syn -> data)
qubit[25] data;
qubit syn;
bit[24] m;

// g0 = Z1 Z6.
reset syn; h syn;
cz syn,data[0]; cz syn,data[5];
h syn; m[0]=measure syn;
barrier data,syn;

// g1 = Z2 Z3 Z7 Z8.
reset syn; h syn;
cz syn,data[1]; cz syn,data[2]; cz syn,data[6]; cz syn,data[7];
