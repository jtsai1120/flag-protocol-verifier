OPENQASM 3.0;
include "stdgates.inc";

// Serial flagged extraction for the [[30,1,5]] rotated surface code,
// generated by gen_cb18_surface.py (CB18 Sec. 3, Fig. 2(b) flag circuit).
//   syndrome ancilla: |+> preparation, X-basis measurement
//   Z check: CZ(syn, data); X check: CX(syn -> data)
//   flag ancilla: |0> preparation, Z-basis measurement; coupling CX(syn -> flag)
qubit[30] data;
qubit syn;
qubit flag;
bit[29] m;
bit[20] f;

// g0 = Z1 Z7.
reset syn; h syn;
cz syn,data[0]; cz syn,data[6];
h syn; m[0]=measure syn;
barrier data,syn,flag;

// g1 = Z2 Z3 Z8 Z9; flag f0.
reset syn; h syn; reset flag;
cz syn,data[1]; cx syn,flag; cz syn,data[2];
cz syn,data[7]; cx syn,flag; cz syn,data[8];
h syn; m[1]=measure syn; f[0]=measure flag;
barrier data,syn,flag;

// g2 = Z4 Z5 Z10 Z11; flag f1.
reset syn; h syn; reset flag;
cz syn,data[3]; cx syn,flag; cz syn,data[4];
cz syn,data[9]; cx syn,flag; cz syn,data[10];
h syn; m[2]=measure syn; f[1]=measure flag;
barrier data,syn,flag;

// g3 = Z6 Z12.
reset syn; h syn;
cz syn,data[5]; cz syn,data[11];
h syn; m[3]=measure syn;
barrier data,syn,flag;

// g4 = Z7 Z8 Z13 Z14; flag f2.
reset syn; h syn; reset flag;
cz syn,data[6]; cx syn,flag; cz syn,data[7];
cz syn,data[12]; cx syn,flag; cz syn,data[13];
h syn; m[4]=measure syn; f[2]=measure flag;
barrier data,syn,flag;

// g5 = Z9 Z10 Z15 Z16; flag f3.
reset syn; h syn; reset flag;
cz syn,data[8]; cx syn,flag; cz syn,data[9];
cz syn,data[14]; cx syn,flag; cz syn,data[15];
h syn; m[5]=measure syn; f[3]=measure flag;
barrier data,syn,flag;

// g6 = Z11 Z12 Z17 Z18; flag f4.
reset syn; h syn; reset flag;
cz syn,data[10]; cx syn,flag; cz syn,data[11];
cz syn,data[16]; cx syn,flag; cz syn,data[17];
h syn; m[6]=measure syn; f[4]=measure flag;
barrier data,syn,flag;

// g7 = Z13 Z19.
reset syn; h syn;
cz syn,data[12]; cz syn,data[18];
h syn; m[7]=measure syn;
barrier data,syn,flag;

// g8 = Z14 Z15 Z20 Z21; flag f5.
reset syn; h syn; reset flag;
cz syn,data[13]; cx syn,flag; cz syn,data[14];
cz syn,data[19]; cx syn,flag; cz syn,data[20];
h syn; m[8]=measure syn; f[5]=measure flag;
barrier data,syn,flag;

// g9 = Z16 Z17 Z22 Z23; flag f6.
reset syn; h syn; reset flag;
cz syn,data[15]; cx syn,flag; cz syn,data[16];
cz syn,data[21]; cx syn,flag; cz syn,data[22];
h syn; m[9]=measure syn; f[6]=measure flag;
barrier data,syn,flag;

// g10 = Z18 Z24.
reset syn; h syn;
cz syn,data[17]; cz syn,data[23];
h syn; m[10]=measure syn;
barrier data,syn,flag;

// g11 = Z19 Z20 Z25 Z26; flag f7.
reset syn; h syn; reset flag;
cz syn,data[18]; cx syn,flag; cz syn,data[19];
cz syn,data[24]; cx syn,flag; cz syn,data[25];
h syn; m[11]=measure syn; f[7]=measure flag;
barrier data,syn,flag;

// g12 = Z21 Z22 Z27 Z28; flag f8.
reset syn; h syn; reset flag;
cz syn,data[20]; cx syn,flag; cz syn,data[21];
cz syn,data[26]; cx syn,flag; cz syn,data[27];
h syn; m[12]=measure syn; f[8]=measure flag;
barrier data,syn,flag;

// g13 = Z23 Z24 Z29 Z30; flag f9.
reset syn; h syn; reset flag;
cz syn,data[22]; cx syn,flag; cz syn,data[23];
cz syn,data[28]; cx syn,flag; cz syn,data[29];
h syn; m[13]=measure syn; f[9]=measure flag;
barrier data,syn,flag;

// g14 = X2 X3.
reset syn; h syn;
cx syn,data[1]; cx syn,data[2];
h syn; m[14]=measure syn;
barrier data,syn,flag;

// g15 = X4 X5.
reset syn; h syn;
cx syn,data[3]; cx syn,data[4];
h syn; m[15]=measure syn;
barrier data,syn,flag;

// g16 = X1 X2 X7 X8; flag f10.
reset syn; h syn; reset flag;
cx syn,data[0]; cx syn,flag; cx syn,data[1];
cx syn,data[6]; cx syn,flag; cx syn,data[7];
h syn; m[16]=measure syn; f[10]=measure flag;
barrier data,syn,flag;

// g17 = X3 X4 X9 X10; flag f11.
reset syn; h syn; reset flag;
cx syn,data[2]; cx syn,flag; cx syn,data[3];
cx syn,data[8]; cx syn,flag; cx syn,data[9];
h syn; m[17]=measure syn; f[11]=measure flag;
barrier data,syn,flag;

// g18 = X5 X6 X11 X12; flag f12.
reset syn; h syn; reset flag;
cx syn,data[4]; cx syn,flag; cx syn,data[5];
cx syn,data[10]; cx syn,flag; cx syn,data[11];
h syn; m[18]=measure syn; f[12]=measure flag;
barrier data,syn,flag;

// g19 = X8 X9 X14 X15; flag f13.
reset syn; h syn; reset flag;
cx syn,data[7]; cx syn,flag; cx syn,data[8];
cx syn,data[13]; cx syn,flag; cx syn,data[14];
h syn; m[19]=measure syn; f[13]=measure flag;
barrier data,syn,flag;

// g20 = X10 X11 X16 X17; flag f14.
reset syn; h syn; reset flag;
cx syn,data[9]; cx syn,flag; cx syn,data[10];
cx syn,data[15]; cx syn,flag; cx syn,data[16];
h syn; m[20]=measure syn; f[14]=measure flag;
barrier data,syn,flag;

// g21 = X13 X14 X19 X20; flag f15.
reset syn; h syn; reset flag;
cx syn,data[12]; cx syn,flag; cx syn,data[13];
cx syn,data[18]; cx syn,flag; cx syn,data[19];
h syn; m[21]=measure syn; f[15]=measure flag;
