barrier data,syn,flag;

// g24 = X20 X21 X26 X27; flag f18.
reset syn; h syn; reset flag;
cx syn,data[19]; cx syn,flag; cx syn,data[20];
cx syn,data[25]; cx syn,flag; cx syn,data[26];
h syn; m[24]=measure syn; f[18]=measure flag;
