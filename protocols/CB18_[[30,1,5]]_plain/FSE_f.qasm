// g25 = X22 X23 X28 X29; flag f19.
reset syn; h syn; reset flag;
cx syn,data[21]; cx syn,flag; cx syn,data[22];
cx syn,data[27]; cx syn,flag; cx syn,data[28];
h syn; m[25]=measure syn; f[19]=measure flag;
barrier data,syn,flag;

// g26 = X25 X26.
reset syn; h syn;
cx syn,data[24]; cx syn,data[25];
h syn; m[26]=measure syn;
barrier data,syn,flag;

// g27 = X27 X28.
reset syn; h syn;
cx syn,data[26]; cx syn,data[27];
h syn; m[27]=measure syn;
barrier data,syn,flag;

// g28 = X29 X30.
reset syn; h syn;
cx syn,data[28]; cx syn,data[29];
h syn; m[28]=measure syn;
barrier data,syn,flag;
