protocol CB18_[[30,1,5]]_plain:

    code:
        [[30,1,5]]

        [[Z1, Z7],
         [Z2, Z3, Z8, Z9],
         [Z4, Z5, Z10, Z11],
         [Z6, Z12],
         [Z7, Z8, Z13, Z14],
         [Z9, Z10, Z15, Z16],
         [Z11, Z12, Z17, Z18],
         [Z13, Z19],
         [Z14, Z15, Z20, Z21],
         [Z16, Z17, Z22, Z23],
         [Z18, Z24],
         [Z19, Z20, Z25, Z26],
         [Z21, Z22, Z27, Z28],
         [Z23, Z24, Z29, Z30],
         [X2, X3],
         [X4, X5],
         [X1, X2, X7, X8],
         [X3, X4, X9, X10],
         [X5, X6, X11, X12],
         [X8, X9, X14, X15],
         [X10, X11, X16, X17],
         [X13, X14, X19, X20],
         [X15, X16, X21, X22],
         [X17, X18, X23, X24],
         [X20, X21, X26, X27],
         [X22, X23, X28, X29],
         [X25, X26],
         [X27, X28],
         [X29, X30]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qd: data
            qm: syn
            g: [[Z1, Z7],
                [Z2, Z3, Z8, Z9],
                [Z4, Z5, Z10, Z11],
                [Z6, Z12],
                [Z7, Z8, Z13, Z14],
                [Z9, Z10, Z15, Z16],
                [Z11, Z12, Z17, Z18],
                [Z13, Z19],
                [Z14, Z15, Z20, Z21],
                [Z16, Z17, Z22, Z23],
                [Z18, Z24],
                [Z19, Z20, Z25, Z26],
                [Z21, Z22, Z27, Z28],
                [Z23, Z24, Z29, Z30],
                [X2, X3],
                [X4, X5],
                [X1, X2, X7, X8],
                [X3, X4, X9, X10],
                [X5, X6, X11, X12],
                [X8, X9, X14, X15],
                [X10, X11, X16, X17],
                [X13, X14, X19, X20],
                [X15, X16, X21, X22],
                [X17, X18, X23, X24],
                [X20, X21, X26, X27],
                [X22, X23, X28, X29],
                [X25, X26],
                [X27, X28],
                [X29, X30]]
        }

        FSE_f {
            file: "./FSE_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1, Z7],
                [Z2, Z3, Z8, Z9],
                [Z4, Z5, Z10, Z11],
                [Z6, Z12],
                [Z7, Z8, Z13, Z14],
                [Z9, Z10, Z15, Z16],
                [Z11, Z12, Z17, Z18],
                [Z13, Z19],
                [Z14, Z15, Z20, Z21],
                [Z16, Z17, Z22, Z23],
                [Z18, Z24],
                [Z19, Z20, Z25, Z26],
                [Z21, Z22, Z27, Z28],
                [Z23, Z24, Z29, Z30],
                [X2, X3],
                [X4, X5],
                [X1, X2, X7, X8],
                [X3, X4, X9, X10],
                [X5, X6, X11, X12],
                [X8, X9, X14, X15],
                [X10, X11, X16, X17],
                [X13, X14, X19, X20],
                [X15, X16, X21, X22],
                [X17, X18, X23, X24],
                [X20, X21, X26, X27],
                [X22, X23, X28, X29],
                [X25, X26],
                [X27, X28],
                [X29, X30]]
            #-flag: 2
        }

    gvar:
        cnt n_c_same = 0;
        cnt n_same = 0;
        cnt n_diff = 0;
        cnt n_flag = 0;

        bit[29] s_prev = ⊥;
        bit diff_prev = 0;
        mr m = mr[];

    tc:
        1: ((n_c_same == 3 - n_diff - 1 and n_c_same != 0) and n_flag == 0)
        2: (n_diff == 2 and n_flag == 0)
        3: (n_flag == 2)
        4: (n_diff == 1 and n_flag == 1)
        5: (n_same == 1 and n_diff == 0 and n_flag == 1)

    af:
        while(!tc) {
            bit[29] s = ⊥;
            bit[20] f = ⊥;
            (s, f) = FSE_f();

            if (f != 0) {
                n_c_same = 0;
                n_same = 0;
                n_flag += 1;
                s_prev = ⊥;
                diff_prev = 0;
                m.push(f);
                continue;
            }

            if (s_prev != ⊥) {
                if (diff_prev == 1) { diff_prev = 0; }
                else if (s == s_prev) {
                    n_c_same += 1;
                    n_same += 1;
                }
                else {
                    n_c_same = 0;
                    n_diff += 1;
                    diff_prev = 1;
                }
            }
            s_prev = s;
        }

    ta:
        1: { decode(mr[s_prev]); }
        2: {
            bit[29] s = ⊥;
            (s,) = FSE_b();
            decode(mr[s]);
        }
        3: {
            bit[29] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m);
        }
        4: {
            bit[29] s = ⊥;
            (s,) = FSE_b();
            m.push(s);
            decode(m);
        }
        5: {
            m.push(s_prev);
            decode(m);
        }
