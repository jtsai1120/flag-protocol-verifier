         [X17, X18, X24, X25],
         [X19, X20, X26, X27],
         [X23, X24, X30, X31],
         [X25, X26, X32, X33],
         [X27, X28, X34, X35],
         [X29, X30],
         [X31, X32],
         [X33, X34]]

    se:
        FSE_b {
            file: "./FSE_b.qasm"
            qd: data
            qm: syn
            g: [[Z1, Z8],
                [Z2, Z3, Z9, Z10],
                [Z4, Z5, Z11, Z12],
                [Z6, Z7, Z13, Z14],
                [Z8, Z9, Z15, Z16],
                [Z10, Z11, Z17, Z18],
                [Z12, Z13, Z19, Z20],
                [Z14, Z21],
                [Z15, Z22],
                [Z16, Z17, Z23, Z24],
                [Z18, Z19, Z25, Z26],
                [Z20, Z21, Z27, Z28],
                [Z22, Z23, Z29, Z30],
                [Z24, Z25, Z31, Z32],
                [Z26, Z27, Z33, Z34],
                [Z28, Z35],
                [X2, X3],
                [X4, X5],
                [X6, X7],
                [X1, X2, X8, X9],
                [X3, X4, X10, X11],
                [X5, X6, X12, X13],
                [X9, X10, X16, X17],
                [X11, X12, X18, X19],
                [X13, X14, X20, X21],
                [X15, X16, X22, X23],
                [X17, X18, X24, X25],
                [X19, X20, X26, X27],
                [X23, X24, X30, X31],
                [X25, X26, X32, X33],
                [X27, X28, X34, X35],
                [X29, X30],
                [X31, X32],
                [X33, X34]]
        }

        FSE_f {
            file: "./FSE_f.qasm"
            qd: data
            qm: syn
            qf: flag
            g: [[Z1, Z8],
                [Z2, Z3, Z9, Z10],
                [Z4, Z5, Z11, Z12],
                [Z6, Z7, Z13, Z14],
                [Z8, Z9, Z15, Z16],
                [Z10, Z11, Z17, Z18],
                [Z12, Z13, Z19, Z20],
                [Z14, Z21],
                [Z15, Z22],
                [Z16, Z17, Z23, Z24],
                [Z18, Z19, Z25, Z26],
                [Z20, Z21, Z27, Z28],
                [Z22, Z23, Z29, Z30],
                [Z24, Z25, Z31, Z32],
                [Z26, Z27, Z33, Z34],
                [Z28, Z35],
                [X2, X3],
                [X4, X5],
                [X6, X7],
                [X1, X2, X8, X9],
                [X3, X4, X10, X11],
                [X5, X6, X12, X13],
                [X9, X10, X16, X17],
                [X11, X12, X18, X19],
