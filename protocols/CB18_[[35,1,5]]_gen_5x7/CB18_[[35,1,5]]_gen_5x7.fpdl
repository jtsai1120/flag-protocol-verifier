protocol CB18_[[35,1,5]]_gen_5x7:

    code:
        [[35,1,5]]

        [[Z1, Z8],
         [Z2, Z3, Z9, Z10],
         [Z4, Z5, Z11, Z12],
         [Z6, Z7, Z13, Z14],
